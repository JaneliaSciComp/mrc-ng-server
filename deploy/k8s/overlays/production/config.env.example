# Copy to config.env and edit. Consumed by mrc-ng-server via envFrom.
# config.env is gitignored — never commit real values. All keys use the MRCNG_
# prefix (pydantic-settings, see src/mrcng/server/config.py).

# Read-only root of the MRC data tree. MUST match the mountPath of the
# catalog-data volume in k8s/base/deployment.yaml AND the CATALOG_DATA_ROOT the
# ai-cryoet scanner/API use — the API builds precomputed:// URLs from each
# tomogram's mrc_path relative to this root.
MRCNG_SOURCE_ROOT=/groups/cryoet/cryoet/data

# Shared pyramid cache (the mrc-cache volume, mounted at /cache). Written by the
# ai-cryoet scanner's `mrc-pyramid build` step, read here. MUST match the
# --cache-root the scanner builds with.
MRCNG_CACHE_ROOT=/cache

# Browser origins allowed to fetch chunks (CORS). The Neuroglancer viewer app
# fetches cross-origin, so this must include the viewer's origin. "*" also works
# but scope it in production.
MRCNG_CORS_ORIGINS=https://fileglancer.int.janelia.org

# Downsample chunk size. MUST match whatever `mrc-pyramid build` used, or caches
# read as incompatible and only scale 0 is served. Default 64,64,64.
# MRCNG_CHUNK_SIZE=64,64,64

# Max open file descriptors kept warm (keep well under the pod's ulimit -n).
# MRCNG_FD_CACHE_SIZE=256

# Max concurrent chunk reads before requests queue.
# MRCNG_MAX_CONCURRENT_READS=32
